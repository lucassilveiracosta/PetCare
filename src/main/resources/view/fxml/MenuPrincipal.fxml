<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="backgroundvbox" alignment="CENTER" prefHeight="400" prefWidth="400" spacing="16" style="-fx-padding: 40;" stylesheets="@../../style/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controllers.MenuController">
    <Label fx:id="PetCareStyle" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="PetCare" />
    <Button onAction="#openConsultas" prefHeight="40" prefWidth="220" text="Consultations" />
    <Button onAction="#openDashboard" prefHeight="40" prefWidth="220" text="Appointment Dashboard" />
    <Button onAction="#openAttendant" prefHeight="40" prefWidth="220" text="Attendant" />
    <Button onAction="#openAdmin" prefHeight="40" prefWidth="220" text="Admin" />
</VBox>
