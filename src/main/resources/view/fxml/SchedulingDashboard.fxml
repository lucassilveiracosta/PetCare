<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" style="-fx-padding: 10;" stylesheets="@../../style/style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="gui.AppointmentDashboardController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Appointment Dashboard" />
        <HBox HBox.hgrow="ALWAYS" />
        <Button fx:id="btnViewConsultation" disable="true" onAction="#handleViewConsultation" text="View Consultation" />
        <Button fx:id="btnRefresh" onAction="#handleRefresh" text="Refresh" />
    </HBox>

    <!-- Summary cards -->
    <HBox spacing="10">
        <VBox fx:id="cardPending" alignment="CENTER" prefWidth="100" spacing="4" style="-fx-padding: 10; -fx-border-color: gray; -fx-cursor: hand;">
            <Label fx:id="cntPending" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0" />
            <Label text="Pending" />
        </VBox>
        <VBox fx:id="cardInProgress" alignment="CENTER" prefWidth="100" spacing="4" style="-fx-padding: 10; -fx-border-color: gray; -fx-cursor: hand;">
            <Label fx:id="cntInProgress" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0" />
            <Label text="In Progress" />
        </VBox>
        <VBox fx:id="cardExpired" alignment="CENTER" prefWidth="100" spacing="4" style="-fx-padding: 10; -fx-border-color: gray; -fx-cursor: hand;">
            <Label fx:id="cntExpired" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0" />
            <Label text="Expired" />
        </VBox>
        <VBox fx:id="cardCompleted" alignment="CENTER" prefWidth="100" spacing="4" style="-fx-padding: 10; -fx-border-color: gray; -fx-cursor: hand;">
            <Label fx:id="cntCompleted" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0" />
            <Label text="Completed" />
        </VBox>
    </HBox>

    <!-- Filter bar -->
    <HBox spacing="6">
        <ToggleButton fx:id="btnAll" onAction="#handleFilter" selected="true" text="All" />
        <ToggleButton fx:id="btnPending" onAction="#handleFilter" text="Pending" />
        <ToggleButton fx:id="btnInProgress" onAction="#handleFilter" text="In Progress" />
        <ToggleButton fx:id="btnExpired" onAction="#handleFilter" text="Expired" />
        <ToggleButton fx:id="btnCompleted" onAction="#handleFilter" text="Completed" />
    </HBox>

    <!-- Table -->
    <TableView fx:id="tableAppointments" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colStatus" prefWidth="120" text="Status" />
            <TableColumn fx:id="colAnimal" prefWidth="110" text="Animal" />
            <TableColumn fx:id="colVet" prefWidth="180" text="Veterinarian" />
            <TableColumn fx:id="colDate" prefWidth="140" text="Date / Time (MM/dd/yyyy HH:mm)" />
            <TableColumn fx:id="colDesc" prefWidth="250" text="Description" />
        </columns>
        <placeholder>
            <Label text="No appointments found." />
        </placeholder>
    </TableView>
</VBox>
