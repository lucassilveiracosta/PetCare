<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" stylesheets="@../../style/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controllers.AdminClinicalHistoryController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16" />
    </padding>

    <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />
    <Label fx:id="lblTitle" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Pet Clinical History" />
    <Label text="Pick a pet and a period (week / month / custom) to see and export its consultations." />

    <FlowPane hgap="10" vgap="8">
        <Label text="Pet:" />
        <ChoiceBox fx:id="cbPet" prefWidth="180" />
        <Label text="   Period:" />
        <ChoiceBox fx:id="cbPeriod" prefWidth="150" />
        <Label text="   From:" />
        <DatePicker fx:id="dpFrom" editable="false" />
        <Label text="To:" />
        <DatePicker fx:id="dpTo" editable="false" />
        <Button onAction="#handleShow" text="Show" />
    </FlowPane>

    <TableView fx:id="tableConsults" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" prefWidth="150" text="Date / Time" />
            <TableColumn fx:id="colVet" prefWidth="170" text="Veterinarian" />
            <TableColumn fx:id="colDiagnosis" prefWidth="220" text="Diagnosis" />
            <TableColumn fx:id="colStatus" prefWidth="110" text="Status" />
            <TableColumn fx:id="colPrice" prefWidth="100" text="Price" />
        </columns>
        <placeholder>
            <Label text="No consultations in this period." />
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnExport" onAction="#handleExportPdf" text="Export History (PDF)" />
        <Region HBox.hgrow="ALWAYS" />
        <Label style="-fx-font-weight: bold;" text="Consultations:" />
        <Label fx:id="lblCount" style="-fx-font-weight: bold; -fx-text-fill: #1B365D;" text="0" />
    </HBox>
</VBox>
