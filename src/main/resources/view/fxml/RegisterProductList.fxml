<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.5" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controllers.RegisterProductListController">
  <items>
    <!-- Available products -->
    <AnchorPane minHeight="0.0" minWidth="0.0">
       <children>
          <VBox spacing="8.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
             <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
             </padding>
             <children>
                <Label style="-fx-font-weight: bold;" text="Available Products" />
                <Label text="Click a product to add it to the cart." />
                <ListView fx:id="listproduct" VBox.vgrow="ALWAYS" />
                <Button fx:id="addProduct" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openAddProduct" prefHeight="38.0" text="Add Product" />
             </children>
          </VBox>
       </children>
    </AnchorPane>

    <!-- Cart / payment -->
    <AnchorPane minHeight="0.0" minWidth="0.0">
       <children>
          <VBox spacing="14.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
             <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
             </padding>
             <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Cart" />
                <ListView fx:id="cartList" VBox.vgrow="ALWAYS" />
                <HBox spacing="10.0">
                   <children>
                      <Button mnemonicParsing="false" onAction="#removeFromCart" text="Remove selected" />
                      <Button mnemonicParsing="false" onAction="#clearCart" text="Clear cart" />
                   </children>
                </HBox>

                <!-- Total card (flexbox: label left, value right) -->
                <HBox fx:id="boxtotalvalue" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="12.0" style="-fx-background-color: #1B365D; -fx-background-radius: 12; -fx-padding: 16 22;">
                   <children>
                      <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Total" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="valuetotal" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" text="R$ 0.00" />
                   </children>
                </HBox>

                <Button fx:id="payment" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onPayment" prefHeight="42.0" text="Payment" />
                <Button fx:id="backButtonStyle" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#backbutton" prefHeight="42.0" text="Back" />
             </children>
          </VBox>
       </children>
    </AnchorPane>
  </items>
   <stylesheets>
      <URL value="@../../style/GeneralModels.css" />
      <URL value="@../../style/RegisterProductList.css" />
   </stylesheets>
</SplitPane>
