<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" stylesheets="@../../style/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AdminStockController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16" />
    </padding>

    <Label fx:id="lblTitle" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Manage Stock" />

    <HBox spacing="10">
        <ToggleButton fx:id="btnPetShop" text="Pet Shop Products" />
        <ToggleButton fx:id="btnVet" text="Medicines (Vet)" />
        <Button onAction="#handleRefresh" text="Refresh" />
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Left: products table -->
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <TableView fx:id="tableProducts" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" prefWidth="160" text="Name" />
                    <TableColumn fx:id="colQty" prefWidth="70" text="Qty" />
                    <TableColumn fx:id="colPrice" prefWidth="90" text="Price" />
                    <TableColumn fx:id="colType" prefWidth="110" text="Med. Type" />
                    <TableColumn fx:id="colDescription" prefWidth="220" text="Description" />
                </columns>
                <placeholder>
                    <Label text="No products found." />
                </placeholder>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btnDelete" onAction="#handleDelete" text="Delete" />
            </HBox>
        </VBox>

        <!-- Right: product form -->
        <VBox spacing="8" prefWidth="320">
            <Label style="-fx-font-weight: bold;" text="Product details" />
            <Label text="Name:" />
            <TextField fx:id="fieldName" />
            <Label text="Quantity:" />
            <TextField fx:id="fieldQuantity" />
            <Label text="Price:" />
            <TextField fx:id="fieldPrice" />
            <Label text="Description:" />
            <TextArea fx:id="fieldDescription" prefHeight="60" wrapText="true" />
            <CheckBox fx:id="chkIsVet" text="Veterinarian product (medicine)" />
            <Label text="Medicine type:" />
            <ChoiceBox fx:id="cbMedicineType" prefWidth="180" />
            <HBox spacing="10">
                <Button fx:id="btnAdd" onAction="#handleAdd" text="Add New" />
                <Button fx:id="btnSave" onAction="#handleSave" text="Save Changes" />
                <Button onAction="#handleClear" text="Clear" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
