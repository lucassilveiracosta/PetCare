<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" stylesheets="@../../style/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AdminStockController">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16" />
    </padding>

    <Label fx:id="lblTitle" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Manage Stock" />

    <HBox spacing="10">
        <ToggleButton fx:id="btnPetShop" text="Pet Shop Products" />
        <ToggleButton fx:id="btnVet" text="Medicines (Vet)" />
        <Button onAction="#handleRefresh" text="Refresh" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleAddProduct" text="Add Product" />
    </HBox>

    <Label text="Select a product:" />
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="productRadios" spacing="6">
                <padding>
                    <Insets bottom="8" left="8" right="8" top="8" />
                </padding>
            </VBox>
        </content>
    </ScrollPane>

    <!-- Counter for the selected product -->
    <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-background-color: #EBF3F9; -fx-background-radius: 10; -fx-padding: 12 16;">
        <children>
            <Label style="-fx-font-weight: bold;" text="Selected:" />
            <Label fx:id="lblSelectedName" text="—" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleDecrease" prefWidth="44.0" text="−" />
            <Label fx:id="lblCount" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-min-width: 40; -fx-alignment: center;" text="0" />
            <Button onAction="#handleIncrease" prefWidth="44.0" text="+" />
        </children>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button onAction="#handleReport" text="Generate Stock Report (PDF)" />
        <Region HBox.hgrow="ALWAYS" />
        <Label style="-fx-font-weight: bold;" text="Stock value:" />
        <Label fx:id="lblTotalValue" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1B365D;" text="R$ 0.00" />
    </HBox>
</VBox>
