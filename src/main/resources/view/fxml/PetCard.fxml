<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.33" prefHeight="600.0" prefWidth="900.0" stylesheets="@../../style/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controllers.PetCardController">
  <items>
    <!-- Left: pet list -->
    <AnchorPane minWidth="0.0">
      <children>
        <VBox spacing="8.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
          </padding>
          <children>
            <Label style="-fx-font-weight: bold;" text="Pets" />
            <ListView fx:id="listPets" VBox.vgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRefresh" text="Refresh" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleBack" text="Back to Attendant Menu" />
          </children>
        </VBox>
      </children>
    </AnchorPane>

    <!-- Right: the pet card -->
    <AnchorPane minWidth="0.0">
      <children>
        <ScrollPane fitToWidth="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <content>
            <VBox fx:id="cardBox" spacing="8.0">
              <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
              </padding>
            </VBox>
          </content>
        </ScrollPane>
      </children>
    </AnchorPane>
  </items>
</SplitPane>
